# ==============================================================================
# RESTAURANTE SMART - PLANTILLA DE VARIABLES DE ENTORNO
# Copiar a .env para uso local y reemplazar todos los valores CHANGE_ME_*.
# NUNCA subir el archivo .env real ni credenciales reales a Git.
# ==============================================================================

# --- Aplicación General ---
APP_ENV=development
APP_NAME=Restaurante Smart API
API_V1_PREFIX=/api/v1
TAX_RATE=0.12

# --- Puertos de Exposición en el Host (vinculados a 127.0.0.1) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
APP_DB_PORT=5432
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
SONARQUBE_PORT=9000
# PORTAINER_HTTPS_PORT=9443  # Perfil ops (Portainer) aplazado temporalmente

# --- PostgreSQL Aplicación (instancia independiente: postgres-app) ---
APP_DB_HOST=postgres-app
APP_DB_NAME=restaurante_smart
APP_DB_USER=restaurante_user
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# --- Seguridad y Autenticación JWT ---
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Backend ---
# Orígenes separados por coma (sin espacios adicionales)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Vite) ---
VITE_API_BASE_URL=/api/v1

# --- PostgreSQL SonarQube (instancia independiente: postgres-sonar) ---
SONAR_DB_HOST=postgres-sonar
SONAR_DB_PORT=5432
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonar_user
SONAR_DB_PASSWORD=CHANGE_ME_SONAR_DB_PASSWORD

# --- Jenkins Agente Aislado (perfil ci) ---
# Secreto JNLP/WebSocket generado por el controlador Jenkins para el nodo restaurante-smart-agent
JENKINS_AGENT_SECRET=CHANGE_ME_JENKINS_AGENT_SECRET
